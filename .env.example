# ==============================================================================
# AURORA 2026 - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env.local' for local development.
# In Vercel, add these variables in: Project Settings -> Environment Variables.
# NOTE: Never commit sensitive keys or database passwords to public repositories!

# Application Environment (development / preview / production)
NODE_ENV=production

# Public Base URL (optional override)
# NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Optional Cloud Database connection string (if switching from localStorage to cloud backend)
# DATABASE_URL=
